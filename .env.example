POSTGRES_USER=chainmind
POSTGRES_PASSWORD=chainmind_dev
POSTGRES_DB=chainmind
POSTGRES_PORT=5432
NEO4J_USER=neo4j
NEO4J_PASSWORD=chainmind_dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BACKEND_PORT=8000
ETH_RPC_URL=https://ethereum.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
RPC_BASE_HTTP=https://mainnet.base.org
SQD_GATEWAY=https://v2.archive.subsquid.io/network/ethereum-mainnet
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------- IA real
# ChainMind elige proveedor solo: el primero disponible en esta prioridad.
#   1. ollama (local, gratis, sin clave, sin datos fuera de tu maquina)
#   2. anthropic  3. openai  4. gemini  5. groq  6. openrouter
# Para fijar uno: CHAINMIND_LLM_PROVIDER=ollama
CHAINMIND_LLM_PROVIDER=
CHAINMIND_LLM_DISABLED=0
CHAINMIND_LLM_TIMEOUT=45
CHAINMIND_LLM_RETRIES=2
CHAINMIND_LLM_CACHE_TTL=3600
CHAINMIND_LLM_BREAKER=3
CHAINMIND_LLM_BREAKER_COOLDOWN=120

# Ollama (IA local, recomendada para datos sensibles)
OLLAMA_URL=http://127.0.0.1:11434
CHAINMIND_LLM_MODEL_OLLAMA=qwen2.5:1.5b

# Nube: pon la clave y la usada ya aparece en /status
ANTHROPIC_API_KEY=
CHAINMIND_LLM_MODEL_ANTHROPIC=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
CHAINMIND_LLM_MODEL_OPENAI=gpt-4o-mini
GEMINI_API_KEY=
CHAINMIND_LLM_MODEL_GEMINI=gemini-2.0-flash
GROQ_API_KEY=
CHAINMIND_LLM_MODEL_GROQ=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
CHAINMIND_LLM_MODEL_OPENROUTER=anthropic/claude-3.5-sonnet
# Cualquier endpoint compatible con OpenAI (vLLM, LM Studio, Together…):
# CHAINMIND_LLM_BASE_URL=http://localhost:8000/v1/chat/completions

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_RISK_THRESHOLD=70
CHAINMIND_SLITHER=0

# Obsidian (si no defines la ruta, detecta el vault de Obsidian en Windows)
CHAINMIND_OBSIDIAN_VAULT=
CHAINMIND_OBSIDIAN_AUTO=0

# Watchlist de direcciones sensibles (JSON). Verifica antes: python scripts/verify_watchlist.py
CHAINMIND_WATCHLIST_URL=
CHAINMIND_WATCHLIST_TTL=21600

# Centinela: vigilancia autonoma 24/7 (lee bloques y entrega alertas)
CHAINMIND_SENTINEL=0
CHAINMIND_SENTINEL_INTERVAL=60
CHAINMIND_SENTINEL_CHAINS=ethereum,base
CHAINMIND_SENTINEL_COOLDOWN=900
CHAINMIND_SENTINEL_MIN_ALERTS=1

# Ajustes de datos
CHAINMIND_FETCH_TTL=20
CHAINMIND_PRICE_TTL=600
